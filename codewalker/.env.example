# MongoDB Atlas connection string (Cluster0, AWS Mumbai region)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=codewalker

# GitHub OAuth app — create one at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_OAUTH_REDIRECT_URI exactly
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Tavily — https://app.tavily.com — used only to ground roleplay monologues
TAVILY_API_KEY=

# Random string for signing session JWTs
JWT_SECRET=change-this-to-a-random-string

FRONTEND_URL=http://localhost:3000
